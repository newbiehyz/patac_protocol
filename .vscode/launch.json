{
  "version": "0.2.0",
  "configurations": [
      {
          "name": "sim_main",
          "type": "cppdbg",
          "request": "launch",
          "program": "${workspaceFolder}/build/run_sim",
          "args": ["../config/config.json", "/home/yukan/Documents/work/python/generate_parking_ekf_data/"],
          "stopAtEntry": false,
          "cwd": "${workspaceFolder}/build",
          "environment": [],
          "externalConsole": false,
          "MIMode": "gdb",
          "setupCommands": [
              {
                  "description": "Enable pretty-printing for gdb",
                  "text": "-enable-pretty-printing",
                  "ignoreFailures": true
              },
              {
                  "description": "Set disassembly flavor to Intel",
                  "text": "-gdb-set disassembly-flavor intel",
                  "ignoreFailures": true
              }
          ],
          "miDebuggerPath": "/usr/bin/gdb",
          "linux": {
              "MIMode": "gdb",
              "miDebuggerPath": "/usr/bin/gdb"
          }
      }
  ]
}